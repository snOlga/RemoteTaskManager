<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetOrb.Core" Version="1.0.14" />
  </ItemGroup>

  <Target Name="CompileIdl" BeforeTargets="BeforeCompile">
    <Exec Command="dotnet tool run DotNetOrb.IdlCompiler -o $(ProjectDir)compiled_idls -naming_scheme idl $(ProjectDir)Idl\metrics.idl" />
  </Target>

</Project>
